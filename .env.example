# ClearSkies AI Environment Configuration
# Copy this file to .env.local for local development

# Google Gemini API Key (Official Google GenAI SDK)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model ID (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# World Air Quality Index (WAQI) API Token (Optional, for ground-station observations)
# Obtain from: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# Default Air Quality Provider: "open-meteo" (default, free, no key needed) or "waqi"
AQI_PROVIDER=open-meteo

# Weather API Key (Optional if using Open-Meteo Weather which requires no key)
WEATHER_API_KEY=
